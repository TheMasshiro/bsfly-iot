# Every VITE_ value ships in the public bundle. The MQTT user MUST be subscribe-only (subscribe devices/+/sensors and devices/+/actuators/#, no publish).
VITE_BACKEND_URL=https://your-backend.example.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_MQTT_BROKER_URL=wss://your-broker.example.com:8084/mqtt
VITE_MQTT_USERNAME=bsfly-web-subscriber
VITE_MQTT_PASSWORD=replace_me
